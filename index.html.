// ── FILTER + SORT ─────────────────────────────────────────────────
function buildCards(){
  let list=[...ALL_WORDS];
  if(state.selCh!==0)list=list.filter(w=>w.ch===state.selCh);
  if(state.selType!=='ALL')list=list.filter(w=>w.type===state.selType);
  if(state.search.trim()){
    const q=state.search.toLowerCase();
    list=list.filter(w=>w.de.toLowerCase().includes(q)||w.en.toLowerCase().includes(q)||w.gram.toLowerCase().includes(q));
  }
  if(state.dueOnly)list=list.filter(w=>isDue(state.srs[cKey(w)]));
  list.sort((a,b)=>{
    const sa=state.srs[cKey(a)],sb=state.srs[cKey(b)];
    if(!sa&&!sb)return 0;if(!sa)return -1;if(!sb)return 1;
    return new Date(sa.nextReview)-new Date(sb.nextReview);
  });
  if(state.isShuf){
    for(let i=list.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[list[i],list[j]]=[list[j],list[i]];}
  }
  return list;
}

