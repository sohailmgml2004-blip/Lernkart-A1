  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;
  a.download='Netzwerk_Neu_A1_Progress_Backup_'+new Date().toISOString().slice(0,10)+'.json';
  document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  alert('Backup downloaded. Keep this JSON file safe so you can restore your progress later.');
}
function restoreProgressBackup(file){
  if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{
    try{
      const data=JSON.parse(reader.result);
      if(!data || typeof data!=='object' || !data.srs || !data.notes || !data.settings) throw new Error('Invalid backup');
      if(!confirm('Restore this backup? Your current progress, notes, and settings will be replaced by the backup.')) return;
      LS.set('srs_v1',data.srs);LS.set('notes_v1',data.notes);LS.set('srs_cfg_v1',data.settings);
      state.srs=data.srs;state.notes=data.notes;state.settings=data.settings;state.idx=0;state.flipped=false;
      render();
      alert('Backup restored successfully!');
    }catch(e){alert('This file is not a valid Netzwerk Neu A1 progress backup. Please choose a backup JSON file created by this app.');}
  };
  reader.onerror=()=>alert('Could not read this file. Please try again.');
  reader.readAsText(file);
}

