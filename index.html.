function getConj(de,vd){
  const inf=de.split(',')[0].split('(')[0].trim().toLowerCase();
  if(vd.ich!==undefined){
    return{ich:vd.ich,du:vd.du,er:vd.er,wir:vd.wir,ihr:vd.ihr,sie:vd.sie};
  }
  let stem=inf.endsWith('en')?inf.slice(0,-2):inf.endsWith('n')?inf.slice(0,-1):inf;
  let ich=stem+'e', du=stem+'st', er=stem+'t', wir=inf.includes('en')?inf:inf+'en', ihr=stem+'t', sie=wir;
  if(/[td]$/.test(stem)){du=stem+'est';er=stem+'et';ihr=stem+'et';}
  if(/[sßzx]$/.test(stem)){du=stem+'t';}
  if(vd.du)du=vd.du; if(vd.er)er=vd.er;
  return{ich,du,er,wir,ihr,sie};
}

