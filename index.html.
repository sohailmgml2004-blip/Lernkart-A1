// ── SRS ──────────────────────────────────────────────────────────
function cKey(w){return w.ch+'_'+w.de.replace(/\W/g,'').slice(0,12);}
function calcSRS(q,{interval=0,ef=2.5,reps=0}={},s={}){
  const sd=s.schwerDays??1, od=s.okDays??6, lm=s.leichtMult??1.3;
  let newEF,newReps,newInt;
  if(q<3){newReps=0;newInt=sd;newEF=Math.max(1.3,ef-0.2);}
  else{
    newReps=reps+1;
    newEF=Math.max(1.3,ef+(0.1-(5-q)*(0.08+(5-q)*0.02)));
    if(newReps===1)newInt=1;
    else if(newReps===2)newInt=od;
    else newInt=Math.round(interval*newEF);
    if(q===5)newInt=Math.round(newInt*lm);
  }
  const d=new Date();d.setDate(d.getDate()+newInt);
  return{interval:newInt,ef:newEF,reps:newReps,nextReview:d.toISOString().slice(0,10)};
}
function nextLabel(s){
  if(!s)return{text:'Neu',color:'#8b949e'};
  const diff=Math.round((new Date(s.nextReview)-new Date())/86400000);
  if(diff<=0)return{text:'⏰ Heute!',color:'#e94560'};
  if(diff===1)return{text:'Morgen',color:'#f59e0b'};
  if(diff<7)return{text:'In '+diff+' Tagen',color:'#f59e0b'};
  if(diff<30)return{text:'In '+Math.round(diff/7)+' Wo.',color:'#10b981'};
  return{text:'In '+Math.round(diff/30)+' Mo.',color:'#3b82f6'};
}
function isDue(s){return!s||new Date(s.nextReview)<=new Date();}

