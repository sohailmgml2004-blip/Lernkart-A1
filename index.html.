<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>🇩🇪 Netzwerk Neu A1 – Lernkarten</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0d1117;--surface:#161b22;--surface2:#21262d;--border:#30363d;
  --text:#c9d1d9;--text2:#8b949e;--text3:#484f58;--white:#f0f6fc;
  --red:#e94560;--blue:#3b82f6;--green:#10b981;--amber:#f59e0b;
  --purple:#a855f7;--cyan:#06b6d4;--pink:#ec4899;--lime:#84cc16;
}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;padding-bottom:32px}
button{cursor:pointer;font-family:inherit}

/* HEADER */
.header{background:var(--surface);border-bottom:1px solid var(--border);padding:12px 14px;position:sticky;top:0;z-index:50}
.header-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.logo{width:34px;height:34px;background:var(--red);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.app-title{font-weight:700;font-size:14px;color:var(--white)}
.app-sub{font-size:11px;color:var(--text2)}
.tab-btns{display:flex;gap:4px;margin-left:auto}
.tab-btn{padding:5px 10px;border-radius:8px;border:none;background:var(--surface2);color:var(--text2);font-size:14px}
.tab-btn.active{background:var(--red);color:#fff}
.stats-bar{display:flex;gap:6px}
.stat-box{flex:1;background:var(--surface2);border-radius:8px;padding:5px 4px;text-align:center}
.stat-val{font-size:16px;font-weight:700}
.stat-lbl{font-size:8px;color:var(--text2)}

/* CHAPTER TABS */
.ch-scroll{overflow-x:auto;display:flex;gap:5px;padding:8px 12px;background:var(--surface);border-bottom:1px solid var(--border);scrollbar-width:none}
.ch-scroll::-webkit-scrollbar{display:none}
.ch-btn{padding:5px 9px;border-radius:16px;border:none;white-space:nowrap;background:var(--surface2);color:var(--text2);font-size:9px;font-weight:600}
.ch-btn.active{background:var(--red);color:#fff}

/* BODY */
.body{padding:10px 14px}

/* TYPE PILLS */
.type-pills{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px}
.type-pill{padding:3px 8px;border-radius:14px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:9px;font-weight:600}
.type-pill.active{font-weight:700}

/* SEARCH ROW */
.search-row{display:flex;gap:6px;margin-bottom:8px;align-items:center}
.search-input{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:7px 10px;color:var(--text);font-size:12px;outline:none}
.icon-btn{padding:7px 9px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--text2);font-size:13px}
.icon-btn.on{background:#23863622;color:#3fb950;border-color:#238636}
.icon-btn.due-on{background:#e9456022;color:var(--red);border-color:var(--red)}

/* FLIP TOGGLE */
.flip-row{display:flex;gap:5px;margin-bottom:8px;justify-content:center}
.flip-btn{padding:4px 12px;border-radius:16px;border:none;background:var(--surface2);color:var(--text2);font-size:10px;font-weight:600}
.flip-btn.de{background:var(--red);color:#fff}
.flip-btn.en{background:var(--blue);color:#fff}

/* PROGRESS */
.prog-row{display:flex;justify-content:space-between;font-size:10px;color:var(--text2);margin-bottom:4px}
.prog-bar{height:3px;background:var(--surface2);border-radius:3px;margin-bottom:10px}
.prog-fill{height:100%;border-radius:3px;transition:width .3s}

/* CARD */
.card{border-radius:14px;padding:28px 16px 16px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:230px;position:relative;transition:all .2s;cursor:pointer;margin-bottom:10px;border:1px solid var(--border);background:var(--surface2)}
.card.flipped{background:var(--surface)}
.card-badge{position:absolute;bottom:10px;left:12px;font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px}
.card-edit{position:absolute;top:10px;right:10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text2);font-size:13px;padding:4px 7px}
.card-note-badge{position:absolute;top:10px;left:10px;background:#84cc1622;border:1px solid #84cc16;border-radius:6px;padding:2px 6px;font-size:9px;color:#84cc16}
.card-front-word{font-size:24px;font-weight:800;color:var(--white);margin-bottom:8px;line-height:1.3}
.card-hint{font-size:11px;color:var(--text2);margin-bottom:2px}
.card-tap{margin-top:10px;font-size:10px;color:var(--text3);letter-spacing:1px}
.audio-row{display:flex;gap:8px;margin-top:10px}
.audio-btn{padding:6px 14px;border-radius:20px;border:1px solid;font-size:11px;font-weight:600}
.card-back-en{font-size:18px;font-weight:700;margin-bottom:6px}
.card-divider{width:24px;height:1px;background:var(--border);margin:5px 0}
.card-ex{font-size:13px;font-style:italic;color:var(--text);margin-bottom:3px;line-height:1.5}
.card-exEn{font-size:11px;color:var(--text2);line-height:1.5;margin-bottom:4px}

/* GRAMMAR BOX */
.gram-box{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:8px 12px;margin-top:7px;width:100%;text-align:left}
.gram-label{font-size:9px;font-weight:700;letter-spacing:1px;margin-bottom:4px}
.gram-line{font-size:11px;color:var(--text);margin-bottom:2px}
.gram-key{font-weight:600}

/* CONJ TABLE */
.conj-box{border-radius:10px;padding:10px 12px;margin-top:7px;width:100%;text-align:left}
.conj-label{font-size:9px;font-weight:700;letter-spacing:1px;margin-bottom:8px}
.conj-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px 6px}
.conj-cell{display:flex;gap:6px;align-items:baseline}
.conj-pron{color:var(--text2);font-size:9px;width:48px;flex-shrink:0}
.conj-form{color:var(--white);font-weight:700;font-size:12px}
.conj-sep-hint{margin-top:5px;font-size:9px;font-style:italic}
.kasus-box{border-radius:10px;padding:8px 12px;margin-top:6px;width:100%;text-align:left}
.kasus-label{font-size:9px;font-weight:700;letter-spacing:1px;margin-bottom:3px}
.kasus-val{font-size:12px;font-weight:700;margin-bottom:2px}
.kasus-tip{font-size:11px;font-style:italic;color:var(--text)}

/* NOTE BOX */
.note-box{margin-top:8px;background:#84cc1611;border:1px solid #84cc1644;border-radius:8px;padding:7px 10px;width:100%;text-align:left}
.note-lbl{font-size:9px;color:#84cc16;font-weight:700;margin-bottom:2px}
.note-txt{font-size:12px;color:var(--text)}
.next-lbl{margin-top:6px;font-size:10px;font-weight:600}

/* RATING BUTTONS */
.rating-hint{font-size:10px;color:var(--text2);text-align:center;margin-bottom:6px}
.rating-row{display:flex;gap:6px;margin-bottom:8px}
.rate-btn{flex:1;padding:11px 4px;border-radius:10px;font-weight:700;font-size:11px;border:1px solid}
.nav-row{display:flex;gap:6px;margin-bottom:8px}
.nav-btn{flex:1;padding:11px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:13px;font-weight:600}
.nav-btn:disabled{color:var(--text3);cursor:not-allowed}
.flip-action{flex:3;padding:11px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:13px;font-weight:600}

/* STATS TAB */
.stats-section{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:12px}
.stats-title{font-size:12px;color:var(--white);font-weight:700;margin-bottom:10px}
.stat-row{margin-bottom:8px}
.stat-row-top{display:flex;justify-content:space-between;font-size:11px;margin-bottom:2px}
.mini-bar{height:4px;background:var(--surface2);border-radius:3px}
.mini-fill{height:100%;border-radius:3px}
.type-stat-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.type-stat-bar-wrap{flex:1;height:4px;background:var(--surface2);border-radius:3px}
.gram-tip-row{display:flex;gap:8px;margin-bottom:5px;align-items:flex-start}

/* SETTINGS TAB */
.settings-section{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:12px}
.settings-title{font-size:12px;color:var(--white);font-weight:700;margin-bottom:12px}
.slider-block{margin-bottom:16px}
.slider-header{display:flex;justify-content:space-between;margin-bottom:6px;align-items:center}
.slider-label{font-size:13px;font-weight:700}
.slider-val{font-size:14px;font-weight:700}
.slider-sub{font-size:10px;color:var(--text2);margin-left:8px}
input[type=range]{width:100%;margin:0}
.slider-scale{display:flex;justify-content:space-between;font-size:9px;color:var(--text3);margin-top:2px}
.preview-box{background:var(--surface2);border-radius:8px;padding:10px 12px;margin-top:12px}
.preview-lbl{font-size:10px;color:var(--text2);margin-bottom:6px}
.preview-row{display:flex;gap:8px}
.preview-cell{flex:1;text-align:center;border-radius:6px;padding:6px 4px;border:1px solid}
.preview-cell-lbl{font-size:9px;margin-bottom:2px}
.preview-cell-val{font-size:13px;font-weight:700;color:var(--white)}
.audio-test-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.audio-test-btn{padding:8px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:11px}
.reset-btn{width:100%;padding:10px;border-radius:8px;border:1px solid #f85149;background:transparent;color:#f85149;font-size:12px}

/* EDIT MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px;width:100%;max-width:420px}
.modal-title{font-weight:700;color:var(--white);font-size:15px;margin-bottom:4px}
.modal-sub{font-size:11px;color:var(--text2);margin-bottom:12px}
.modal-preview{border-radius:10px;padding:10px 14px;margin-bottom:12px}
.modal-preview-word{font-size:16px;font-weight:700;color:var(--white)}
.modal-preview-en{font-size:13px;margin-top:2px}
.modal-preview-ex{font-size:11px;color:var(--text2);margin-top:3px;font-style:italic}
textarea{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-size:13px;outline:none;resize:vertical;font-family:inherit}
.modal-btns{display:flex;gap:8px;margin-top:12px}
.modal-save{flex:2;padding:10px;border-radius:10px;border:none;background:#238636;color:#fff;font-weight:700;font-size:13px}
.modal-cancel{flex:1;padding:10px;border-radius:10px;border:1px solid var(--border);background:transparent;color:var(--text2);font-size:13px}

/* EMPTY STATE */
.empty{text-align:center;padding:50px 20px;color:var(--text2)}
</style>
</head>
