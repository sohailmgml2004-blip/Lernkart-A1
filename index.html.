// ── MAIN RENDER ───────────────────────────────────────────────────
function render(){
  const cards=buildCards();
  const si=Math.min(state.idx,Math.max(0,cards.length-1));
  const card=cards[si];
  const key=card?cKey(card):null;
  const cardSRS=key?state.srs[key]:null;
  const cardNote=key?(state.notes[key]||''):'';
  const tc=card?TYPES[card.type]:null;
  const color=tc?.color||'#e94560';
  const nl=nextLabel(cardSRS);
  const due=getDue(),rated=getRated(),mastered=getMastered();
  const total=ALL_WORDS.length;
  const counts={ALL:ALL_WORDS.filter(w=>state.selCh===0||w.ch===state.selCh).length};
  Object.keys(TYPES).forEach(t=>{counts[t]=ALL_WORDS.filter(w=>(state.selCh===0||w.ch===state.selCh)&&w.type===t).length;});

  const app=document.getElementById('app');
  app.innerHTML='';

  // ── HEADER ──
  const header=h('div',{class:'header'});
  const htop=h('div',{class:'header-top'});
  const logo=h('div',{class:'logo'});logo.textContent='🇩🇪';
  const titles=h('div',{});
  const at=h('div',{class:'app-title'});at.textContent='Netzwerk Neu A1 · Lernkarten';
  const as=h('div',{class:'app-sub'});as.textContent='Deutsch A1 · Wortschatz & Grammatik';
  titles.append(at,as);
  const tabs=h('div',{class:'tab-btns'});
  [['study','📚'],['stats','📊'],['settings','⚙️']].forEach(([t,e])=>{
    const b=h('button',{class:'tab-btn'+(state.tab===t?' active':''),onClick:()=>setState({tab:t})});
    b.textContent=e;tabs.appendChild(b);
  });
  htop.append(logo,titles,tabs);
  const sb=h('div',{class:'stats-bar'});
  [{label:'Fällig',val:due,color:'#e94560'},{label:'Gelernt',val:rated,color:'#f59e0b'},
   {label:'Gemeistert',val:mastered,color:'#10b981'},{label:'Gesamt',val:total,color:'#8b949e'}].forEach(s=>{
    const box=h('div',{class:'stat-box'});
    const sv=h('div',{class:'stat-val',style:{color:s.color}});sv.textContent=s.val;
    const sl=h('div',{class:'stat-lbl'});sl.textContent=s.label;
    box.append(sv,sl);sb.appendChild(box);
  });
  header.append(htop,sb);
  // Backup tools: export progress to a portable JSON file and restore it later.
  const backupRow=h('div',{style:{display:'flex',gap:'8px;padding:'+'8px 12px 10px',alignItems:'center',flexWrap:'wrap'}});
  const backupBtn=h('button',{class:'tab-btn',style:{background:'#238636',color:'#fff',fontSize:'11px',padding:'8px 10px'},onClick:exportProgressBackup});
  backupBtn.textContent='⬇️ Backup progress';
  const restoreBtn=h('button',{class:'tab-btn',style:{background:'var(--surface2)',color:'var(--text)',fontSize:'11px',padding:'8px 10px'},onClick:()=>backupInput.click()});
  restoreBtn.textContent='⬆️ Restore backup';
  const backupInput=h('input',{type:'file',accept:'.json,application/json',style:{display:'none'},onChange:e=>{restoreProgressBackup(e.target.files&&e.target.files[0]);e.target.value='';}});
  backupRow.append(backupBtn,restoreBtn,backupInput);
  header.appendChild(backupRow);
  app.appendChild(header);

  // ── SETTINGS TAB ──
  if(state.tab==='settings'){
    const body=h('div',{class:'body'});
    const title=h('div',{style:{fontWeight:'700',color:'var(--white)',marginBottom:'4px',fontSize:'15px'}});
    title.textContent='⚙️ Einstellungen';
    const sub=h('div',{style:{fontSize:'11px',color:'var(--text2)',marginBottom:'14px'}});
    sub.textContent='Passe Wiederholungsabstände und Audio an.';
    body.append(title,sub);

    // SRS Settings
    const sec=h('div',{class:'settings-section'});
    const stitle=h('div',{class:'settings-title'});stitle.textContent='🔁 Wiederholungsabstände (SRS)';
    sec.appendChild(stitle);

    const sliders=[
      {field:'schwerDays',label:'😓 Schwer',sub:'Vergessen → zurück in X Tagen',min:1,max:7,step:1,
        val:state.settings.schwerDays,fmt:v=>v+' Tag'+(v>1?'e':''),color:'#f85149',
        ticks:['1 Tag','3 Tage','7 Tage']},
      {field:'okDays',label:'😐 Ok',sub:'Erster Wiederholungsabstand',min:3,max:14,step:1,
        val:state.settings.okDays,fmt:v=>v+' Tage',color:'#f59e0b',
        ticks:['3 Tage','7 Tage','14 Tage']},
      {field:'leichtMult',label:'😊 Leicht',sub:'Intervall-Multiplikator',min:1.1,max:2.5,step:0.1,
        val:state.settings.leichtMult,fmt:v=>'×'+parseFloat(v).toFixed(1),color:'#10b981',
        ticks:['×1.1','×1.5','×2.5']},
    ];

    sliders.forEach(sl=>{
      const block=h('div',{class:'slider-block'});
      const shead=h('div',{class:'slider-header'});
      const slabel=h('div',{});
      const ll=h('span',{class:'slider-label',style:{color:sl.color}});ll.textContent=sl.label;
      const ls=h('span',{class:'slider-sub'});ls.textContent=sl.sub;
      slabel.append(ll,ls);
      const valEl=h('span',{class:'slider-val',style:{color:sl.color}});valEl.textContent=sl.fmt(sl.val);
      shead.append(slabel,valEl);

      const inp=h('input',{type:'range',min:sl.min,max:sl.max,step:sl.step,value:sl.val,
        style:{accentColor:sl.color},
        onInput:e=>{saveSetting(sl.field,sl.field==='leichtMult'?parseFloat(e.target.value):Number(e.target.value));}});

      const scale=h('div',{class:'slider-scale'});
      sl.ticks.forEach(t=>{const s=h('span',{});s.textContent=t;scale.appendChild(s);});
      block.append(shead,inp,scale);sec.appendChild(block);
    });

    // Preview
    const prev=h('div',{class:'preview-box'});
    const pl=h('div',{class:'preview-lbl'});pl.textContent='📋 Vorschau — nach 10-Tage-Intervall:';
    const pr=h('div',{class:'preview-row'});
    [{label:'😓 Schwer',days:state.settings.schwerDays,color:'#f85149'},
     {label:'😐 Ok',days:Math.round(10*2.5),color:'#f59e0b'},
     {label:'😊 Leicht',days:Math.round(10*state.settings.leichtMult),color:'#10b981'}].forEach(r=>{
      const cell=h('div',{class:'preview-cell',style:{color:r.color,borderColor:r.color+'33',background:r.color+'11'}});
      const cl=h('div',{class:'preview-cell-lbl',style:{color:r.color}});cl.textContent=r.label;
      const cv=h('div',{class:'preview-cell-val'});cv.textContent=r.days+'d';
      cell.append(cl,cv);pr.appendChild(cell);
    });
    prev.append(pl,pr);sec.appendChild(prev);
    body.appendChild(sec);

    // Audio test
    const asec=h('div',{class:'settings-section'});
    const at2=h('div',{class:'settings-title'});at2.textContent='🔊 Audio-Test';
    const ad=h('div',{style:{fontSize:'11px',color:'var(--text2)',marginBottom:'10px'}});
    ad.textContent='Tippe auf eine Phrase, um die deutsche Aussprache zu testen.';
    asec.append(at2,ad);
    const arow=h('div',{class:'audio-test-row'});
    ['Guten Tag!','Wie heißen Sie?','Ich komme aus Deutschland.','Auf Wiedersehen!'].forEach(p=>{
      const b=h('button',{class:'audio-test-btn',onClick:()=>speakEx(p)});b.textContent='🔊 '+p;
      arow.appendChild(b);
    });
    asec.appendChild(arow);body.appendChild(asec);

    // Reset
    const rsec=h('div',{class:'settings-section'});
    const rt=h('div',{class:'settings-title'});rt.textContent='⚠️ Fortschritt zurücksetzen';
    const rb=h('button',{class:'reset-btn',onClick:resetAll});rb.textContent='🗑️ Gesamten Fortschritt löschen';
    rsec.append(rt,rb);body.appendChild(rsec);
    app.appendChild(body);
    return;
  }

  // ── STATS TAB ──
  if(state.tab==='stats'){
    const body=h('div',{class:'body'});
    const title=h('div',{style:{fontWeight:'700',color:'var(--white)',marginBottom:'12px',fontSize:'15px'}});
    title.textContent='📊 Fortschritt';body.appendChild(title);

    const sec=h('div',{class:'stats-section'});
    const st=h('div',{class:'stats-title'});st.textContent='Lernstatus';sec.appendChild(st);
    [{label:'⏰ Heute fällig / Neu',count:due,color:'#e94560'},
     {label:'📖 In Wiederholung',count:Math.max(0,rated-mastered),color:'#f59e0b'},
     {label:'✅ Gemeistert (21+ Tage)',count:mastered,color:'#10b981'},
     {label:'👁️ Noch nicht gesehen',count:Math.max(0,total-rated),color:'#8b949e'}].forEach(r=>{
      const row=h('div',{class:'stat-row'});
      const top=h('div',{class:'stat-row-top'});
      const l=h('span',{style:{color:r.color}});l.textContent=r.label;
      const v=h('span',{style:{color:'var(--white)',fontWeight:'600'}});v.textContent=Math.max(0,r.count);
      top.append(l,v);
      const bar=h('div',{class:'mini-bar'});
      const fill=h('div',{class:'mini-fill',style:{width:Math.round(Math.max(0,r.count)/total*100)+'%',background:r.color}});
      bar.appendChild(fill);row.append(top,bar);sec.appendChild(row);
    });
    body.appendChild(sec);

    const sec2=h('div',{class:'stats-section'});
    const st2=h('div',{class:'stats-title'});st2.textContent='Wortarten';sec2.appendChild(st2);
    Object.entries(TYPES).forEach(([t,cfg])=>{
      const tot=ALL_WORDS.filter(w=>w.type===t).length;
      const r=ALL_WORDS.filter(w=>w.type===t&&state.srs[cKey(w)]?.reps>0).length;
      const row=h('div',{class:'type-stat-row'});
      const em=h('span',{style:{fontSize:'13px',width:'18px'}});em.textContent=cfg.emoji;
      const lbl=h('span',{style:{fontSize:'10px',color:cfg.color,width:'90px',flexShrink:'0'}});lbl.textContent=cfg.label;
      const bwrap=h('div',{class:'type-stat-bar-wrap'});
      const bf=h('div',{style:{height:'4px',width:(r/tot*100)+'%',background:cfg.color,borderRadius:'3px'}});
      bwrap.appendChild(bf);
      const cnt=h('span',{style:{fontSize:'10px',color:'var(--text2)',width:'38px',textAlign:'right'}});
      cnt.textContent=r+'/'+tot;
      row.append(em,lbl,bwrap,cnt);sec2.appendChild(row);
    });
    body.appendChild(sec2);

    const sec3=h('div',{class:'stats-section'});
    const st3=h('div',{class:'stats-title'});st3.textContent='📚 Grammatik-Schnellreferenz';sec3.appendChild(st3);
    [{t:'PREP',tip:'+Akk. immer: durch, ohne, gegen, für, um (DOGFU)'},
     {t:'PREP',tip:'+Dat. immer: aus, bei, mit, nach, seit, von, zu'},
     {t:'PREP',tip:'Wechselpräp.: in, an, auf, über, unter, neben, zwischen, hinter, vor'},
     {t:'V',tip:'Hilfsverb sein: Bewegung/Zustand (gehen, kommen, fahren…)'},
     {t:'V',tip:'Trennbare Verben: Präfix geht ans Satzende!'},
     {t:'KON',tip:'Subordinierend (Verb am Ende!): weil, dass, wenn, ob…'},
     {t:'KON',tip:'Koordinierend (V2): und, aber, oder, denn, sondern'},
    ].forEach(item=>{
      const row=h('div',{class:'gram-tip-row'});
      const em=h('span',{style:{fontSize:'12px',color:TYPES[item.t].color,flexShrink:'0'}});em.textContent=TYPES[item.t].emoji;
      const tip=h('span',{style:{fontSize:'11px',color:'var(--text)',lineHeight:'1.4'}});tip.textContent=item.tip;
      row.append(em,tip);sec3.appendChild(row);
    });
    body.appendChild(sec3);
    app.appendChild(body);
    return;
  }

  // ── STUDY TAB ──
  // Chapter tabs
  const chscroll=h('div',{class:'ch-scroll'});
  CHAPTERS.forEach(c=>{
    const b=h('button',{class:'ch-btn'+(state.selCh===c.id?' active':''),
      onClick:()=>setState({selCh:c.id,idx:0,flipped:false})});
    b.textContent=c.label;chscroll.appendChild(b);
  });
  app.appendChild(chscroll);

  const body=h('div',{class:'body'});

  // Type pills
  const pills=h('div',{class:'type-pills'});
  [['ALL','Alle'],...Object.entries(TYPES).map(([k,v])=>[k,v.emoji+' '+v.label])].forEach(([t,label])=>{
    const tc2=TYPES[t];const isActive=state.selType===t;
    const b=h('button',{class:'type-pill'+(isActive?' active':''),
      style:isActive?{color:tc2?.color||'#e94560',borderColor:tc2?.color||'#e94560',background:(tc2?.color||'#e94560')+'22'}:{},
      onClick:()=>setState({selType:t,idx:0,flipped:false})});
    b.textContent=label+' ('+counts[t]+')';pills.appendChild(b);
  });
  body.appendChild(pills);

  // Search row
  const srow=h('div',{class:'search-row'});
  const sinp=h('input',{class:'search-input',type:'text',placeholder:'🔍 Suchen… DE, EN, Grammatik',value:state.search,
    onInput:e=>setState({search:e.target.value,idx:0,flipped:false})});
  const shuffBtn=h('button',{class:'icon-btn'+(state.isShuf?' on':''),
    onClick:()=>setState({isShuf:!state.isShuf,idx:0,flipped:false})});shuffBtn.textContent='🔀';
  const dueBtn=h('button',{class:'icon-btn'+(state.dueOnly?' due-on':''),
    onClick:()=>setState({dueOnly:!state.dueOnly,idx:0,flipped:false})});dueBtn.textContent='⏰';
  srow.append(sinp,shuffBtn,dueBtn);body.appendChild(srow);

  // Flip direction
  const frow=h('div',{class:'flip-row'});
  ['DE → EN','EN → DE'].forEach((l,i)=>{
    const isDE=i===0;
    const b=h('button',{class:'flip-btn'+(state.showDE===isDE?(isDE?' de':' en'):''),
      onClick:()=>setState({showDE:isDE})});b.textContent=l;frow.appendChild(b);
  });
  body.appendChild(frow);

  if(cards.length===0){
    const empty=h('div',{class:'empty'});empty.textContent='Keine Karten gefunden.';
    body.appendChild(empty);app.appendChild(body);return;
  }

  // Progress bar
  const prow=h('div',{class:'prog-row'});
  const pi=h('span',{});pi.textContent=(si+1)+' / '+cards.length;
  const pnl=h('span',{style:{color:nl.color,fontWeight:'600'}});pnl.textContent=nl.text;
  prow.append(pi,pnl);
  const pbar=h('div',{class:'prog-bar'});
  const pfill=h('div',{class:'prog-fill',style:{width:Math.round(((si+1)/cards.length)*100)+'%',background:color}});
  pbar.appendChild(pfill);
  body.append(prow,pbar);

  // Card
  if(card){
    const cardEl=h('div',{class:'card'+(state.flipped?' flipped':''),
      style:{borderColor:state.flipped?color+'88':'var(--border)'},
      onClick:()=>setState({flipped:!state.flipped})});

    // Edit button
    const editBtn=h('button',{class:'card-edit',onClick:e=>{e.stopPropagation();setState({editCard:card});}});
    editBtn.textContent='✏️';cardEl.appendChild(editBtn);
    if(cardNote){const nb=h('div',{class:'card-note-badge'});nb.textContent='📝';cardEl.appendChild(nb);}

    // Type badge
    if(tc){
      const badge=h('div',{class:'card-badge',style:{color,background:color+'22'}});
      badge.textContent=tc.emoji+' '+tc.label+' · K'+card.ch;cardEl.appendChild(badge);
    }

    if(!state.flipped){
      // FRONT
      const word=h('div',{class:'card-front-word'});word.textContent=state.showDE?card.de:card.en;cardEl.appendChild(word);
      if(state.showDE&&card.type==='V'){const hint=h('div',{class:'card-hint'});hint.textContent='er/sie/es: '+card.extra.split(' · ')[0];cardEl.appendChild(hint);}
      if(state.showDE&&card.type==='N'){const hint=h('div',{class:'card-hint'});hint.textContent=card.extra;cardEl.appendChild(hint);}
      if(state.showDE&&card.type==='PREP'){const hint=h('div',{class:'card-hint',style:{color:'#06b6d4'}});hint.textContent=card.extra;cardEl.appendChild(hint);}
      if(state.showDE&&card.type==='KON'){const hint=h('div',{class:'card-hint',style:{color:'#ec4899'}});hint.textContent='⚠️ '+card.extra;cardEl.appendChild(hint);}

      // Audio buttons
      const arow=h('div',{class:'audio-row'});
      const aw=h('button',{class:'audio-btn',
        style:{color,borderColor:color+'44',background:color+'22'},
        onClick:e=>{e.stopPropagation();speak(state.showDE?card.de:card.en);}});aw.textContent='🔊 Wort';
      const ae=h('button',{class:'audio-btn',
        style:{color:'var(--text2)',borderColor:'var(--border)',background:'var(--surface2)'},
        onClick:e=>{e.stopPropagation();speakEx(card.ex);}});ae.textContent='🔊 Beispiel';
      arow.append(aw,ae);cardEl.appendChild(arow);

      const tap=h('div',{class:'card-tap'});tap.textContent='TIPPEN → UMDREHEN';cardEl.appendChild(tap);
    } else {
      // BACK
      const en=h('div',{class:'card-back-en',style:{color}});en.textContent=state.showDE?card.en:card.de;cardEl.appendChild(en);
      const div=h('div',{class:'card-divider'});cardEl.appendChild(div);
      const ex=h('div',{class:'card-ex'});ex.textContent='„'+card.ex+'"';cardEl.appendChild(ex);
      const exEn=h('div',{class:'card-exEn'});exEn.textContent=card.exEn;cardEl.appendChild(exEn);

      // Verb: conjugation + kasus
      if(card.type==='V'){
        const ct=renderConjTable(card,color);if(ct)cardEl.appendChild(ct);
      }
      // Grammar box (all types)
      const gb=renderGramBox(card.gram,color);if(gb)cardEl.appendChild(gb);

      // Personal note
      if(cardNote){
        const nb2=h('div',{class:'note-box'});
        const nl2=h('div',{class:'note-lbl'});nl2.textContent='📝 MEINE NOTIZ';
        const nt=h('div',{class:'note-txt'});nt.textContent=cardNote;
        nb2.append(nl2,nt);cardEl.appendChild(nb2);
      }
      const nxtlbl=h('div',{class:'next-lbl',style:{color:nl.color}});nxtlbl.textContent=nl.text;cardEl.appendChild(nxtlbl);
    }
    body.appendChild(cardEl);
  }

  // Buttons
  if(state.flipped){
    const rhint=h('div',{class:'rating-hint'});rhint.textContent='Wie sicher bist du? → Bewertung wählen:';
    body.appendChild(rhint);
    const rrow=h('div',{class:'rating-row'});
    const s=state.settings;
    const curInt=cardSRS?.interval||1; const curEF=cardSRS?.ef||2.5; const curReps=cardSRS?.reps||0;
    const okPreview=curReps>=2?Math.round(curInt*curEF)+'d':s.okDays+' T.';
    [{q:1,label:'😓 Schwer',sub:'→ '+s.schwerDays+' Tag'+(s.schwerDays>1?'e':''),color:'#f85149'},
     {q:3,label:'😐 Ok',sub:'→ '+okPreview,color:'#f59e0b'},
     {q:5,label:'😊 Leicht',sub:'→ ×'+s.leichtMult.toFixed(1),color:'#10b981'},
    ].forEach(r=>{
      const b=h('button',{class:'rate-btn',
        style:{color:r.color,borderColor:r.color,background:r.color+'22'},
        onClick:()=>rate(r.q)});
      b.innerHTML=r.label+'<br><span style="font-size:8px">'+r.sub+'</span>';
      rrow.appendChild(b);
    });
    body.appendChild(rrow);
  } else {
    const nrow=h('div',{class:'nav-row'});
    const pb=h('button',{class:'nav-btn',disabled:si===0,onClick:()=>setState({idx:si-1,flipped:false})});pb.textContent='◀';
    const fb=h('button',{class:'flip-action',onClick:()=>setState({flipped:true})});fb.textContent='Umdrehen →';
    const nb=h('button',{class:'nav-btn',disabled:si===cards.length-1,onClick:()=>setState({idx:si+1,flipped:false})});nb.textContent='▶';
    nrow.append(pb,fb,nb);body.appendChild(nrow);
  }

  app.appendChild(body);

  // ── EDIT MODAL ──
  if(state.editCard){
    const ec=state.editCard;const etc=TYPES[ec.type];
    const overlay=h('div',{class:'modal-overlay',onClick:()=>setState({editCard:null})});
    const modal=h('div',{class:'modal',onClick:e=>e.stopPropagation()});
    const mt=h('div',{class:'modal-title'});mt.textContent='✏️ Meine Notiz';
    const ms=h('div',{class:'modal-sub'});ms.textContent='Eselsbrücke, Extra-Beispiel, persönliche Notiz…';
    const mp=h('div',{class:'modal-preview',style:{borderLeft:'3px solid '+(etc?.color||'#e94560')}});
    const mw=h('div',{class:'modal-preview-word'});mw.textContent=ec.de;
    const me=h('div',{class:'modal-preview-en',style:{color:etc?.color||'#e94560'}});me.textContent=ec.en;
    const mx=h('div',{class:'modal-preview-ex'});mx.textContent='„'+ec.ex+'"';
    mp.append(mw,me,mx);
    const ta=h('textarea',{rows:4,placeholder:'z.B. Eselsbrücke: der MAN-n → denk an English man 💡',
      value:state.notes[cKey(ec)]||''});
    const mbtns=h('div',{class:'modal-btns'});
    const msave=h('button',{class:'modal-save',onClick:()=>saveNote(ta.value)});msave.textContent='💾 Speichern';
    const mcancel=h('button',{class:'modal-cancel',onClick:()=>setState({editCard:null})});mcancel.textContent='✕ Abbrechen';
    mbtns.append(msave,mcancel);
    modal.append(mt,ms,mp,ta,mbtns);overlay.appendChild(modal);app.appendChild(overlay);
  }
}

render();
</script>
</body>
</html>
