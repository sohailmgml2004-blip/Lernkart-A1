function rate(q){
  const cards=buildCards();
  const si=Math.min(state.idx,cards.length-1);
  const card=cards[si];
  if(!card)return;
  const k=cKey(card);
  const cur=state.srs[k]||{interval:0,ef:2.5,reps:0};
  const newSRS=calcSRS(q,cur,state.settings);
  const srs={...state.srs,[k]:newSRS};
  LS.set('srs_v1',srs);
  const nextIdx=si<cards.length-1?si+1:si;
  setState({srs,idx:nextIdx,flipped:false});
}

function saveNote(text){
  const cards=buildCards();
  const card=cards[Math.min(state.idx,cards.length-1)];
  if(!card)return;
  const notes={...state.notes,[cKey(card)]:text.trim()};
  LS.set('notes_v1',notes);
  setState({notes,editCard:null});
}

