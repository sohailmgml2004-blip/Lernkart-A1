// ── RENDER HELPERS ───────────────────────────────────────────────
function h(tag,attrs,...children){
  const el=document.createElement(tag);
  if(attrs)Object.entries(attrs).forEach(([k,v])=>{
    if(k==='class')el.className=v;
    else if(k==='style'&&typeof v==='object')Object.assign(el.style,v);
    else if(k.startsWith('on'))el.addEventListener(k.slice(2).toLowerCase(),v);
    else if(k==='disabled')el.disabled=v;
    else if(k==='placeholder')el.placeholder=v;
    else if(k==='type')el.type=v;
    else if(k==='min')el.min=v;
    else if(k==='max')el.max=v;
    else if(k==='step')el.step=v;
    else if(k==='value')el.value=v;
    else if(k==='rows')el.rows=v;
    else if(k==='html')el.innerHTML=v;
    else el.setAttribute(k,v);
  });
  children.flat().forEach(c=>{
    if(c===null||c===undefined)return;
    el.appendChild(typeof c==='string'?document.createTextNode(c):c);
  });
  return el;
}

function renderGramBox(gram,color){
  if(!gram||gram==='—')return null;
  const parts=gram.split(' · ');
  const box=h('div',{class:'gram-box',style:{borderColor:color+'33',background:color+'11'}});
  const lbl=h('div',{class:'gram-label',style:{color}});lbl.textContent='📚 GRAMMATIK';
  box.appendChild(lbl);
  parts.forEach(p=>{
    const [key,...rest]=p.split(':');
    const line=h('div',{class:'gram-line'});
    if(rest.length){
      const ks=h('span',{class:'gram-key',style:{color}});ks.textContent=key+':';
      line.appendChild(ks);
      line.appendChild(document.createTextNode(rest.join(':')));
    } else {
      line.textContent=p;
    }
    box.appendChild(line);
  });
  return box;
}

